{
      "name": "gmail-mcp-server",
      "version": "1.0.0",
      "type": "module",
      "description": "MCP server for Gmail interaction with OAuth authentication",
      "main": "src/index.js",
      "bin": {
            "gmail-mcp": "src/cli.js"
      },
      "scripts": {
            "start": "node src/index.js",
            "dev": "node --watch src/index.js",
            "http": "node src/server-http.js",
            "inspect": "npx -y @modelcontextprotocol/inspector node src/index.js",
            "auth": "node src/auth.js",
            "build": "mkdir -p dist && cp -r src credentials package.json README.md dist/",
            "prepublishOnly": "npm run build"
      },
      "dependencies": {
            "@modelcontextprotocol/sdk": "^1.0.0",
            "commander": "^11.1.0",
            "express": "^4.18.2",
            "google-auth-library": "^9.0.0",
            "googleapis": "^126.0.1",
            "open": "^9.1.0",
            "zod": "^3.22.4"
      }
}
